# Required for Live Agents mode (real Google ADK + Vertex AI pipeline).
# Scripted Demo mode works with none of these set.
#
# Local dev auth: run `gcloud auth application-default login` once, then set:
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Optional cost control (docs/COST_OPTIMIZATION.md #7) — only set these for
# a public deploy, not needed for local dev. Gates the paid "live" agent
# endpoints behind a shared key so random web traffic can't spend your
# Vertex AI budget. NEXT_PUBLIC_DEMO_API_KEY is bundled into client JS, so
# this deters casual bots hitting the API directly — it is not real secrecy.
# DEMO_API_KEY=some-shared-secret
# NEXT_PUBLIC_DEMO_API_KEY=some-shared-secret
