# Required for Live Agents mode (real Google ADK + Vertex AI pipeline).
# Scripted Demo mode works with none of these set.
#
# Local dev auth: run `gcloud auth application-default login` once, then set:
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Must be "global", not a regional value like us-central1 — the
# gemini-3.5-flash/-lite models this app uses only resolve on Vertex AI's
# global endpoint as of 2026-08-19 (confirmed via direct API probe; both
# 404 on us-central1). Re-check if you change the model in
# packages/agent/src/model.ts.
GOOGLE_CLOUD_LOCATION=global

# Optional cost control (docs/COST_OPTIMIZATION.md #7) — only set these for
# a public deploy, not needed for local dev. Gates the paid "live" agent
# endpoints behind a shared key so random web traffic can't spend your
# Vertex AI budget. NEXT_PUBLIC_DEMO_API_KEY is bundled into client JS, so
# this deters casual bots hitting the API directly — it is not real secrecy.
# DEMO_API_KEY=some-shared-secret
# NEXT_PUBLIC_DEMO_API_KEY=some-shared-secret

# Memory Bank backend (packages/agent/src/memory/) auto-selects: real
# Firestore when K_SERVICE is set (Cloud Run injects this automatically —
# you never set it yourself), plain in-memory otherwise. Uncomment to force
# one or the other regardless of environment, e.g. to test Firestore
# locally against a real project (needs `gcloud auth application-default
# login` and a Firestore Native-mode database — see scripts/gcp-up.sh).
# MEMORY_BANK_BACKEND=memory
# MEMORY_BANK_BACKEND=firestore

# Sign in with Google (real Calendar read-only access for CalendarAgent —
# see packages/agent/src/tools.ts). A separate OAuth 2.0 Client ID from the
# Vertex AI service account above; create one at Google Cloud Console >
# APIs & Services > Credentials > Create Credentials > OAuth client ID >
# Web application. Add redirect URI http://localhost:3000/api/auth/callback/google
# for local dev (and your deployed URL's equivalent for prod). Everything
# still works without these set — CalendarAgent just falls back to its
# existing simulated tool.
# GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
# Generate with: openssl rand -base64 32
# AUTH_SECRET=some-random-secret
# Cloud Run sits behind a proxy that rewrites the Host header — Auth.js
# refuses to trust that by default outside Vercel. Required for any deploy.
# AUTH_TRUST_HOST=true
