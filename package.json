{
  "name": "life-grid",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run build -w packages/agent",
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w packages/agent && npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "lint": "npm run lint -w apps/web"
  }
}
